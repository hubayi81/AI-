# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 若 .env 中的密钥曾暴露于任何公开/共享环境，请立即到对应平台吊销并轮换。

# DeepSeek（兼容 OpenAI 协议的 Chat 模型）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 跨域来源（浏览器直连 Python 时才需要；当前架构由 Java 服务端调用，可留默认）
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# MySQL / Redis（架构 A：Python 直连读商品与反馈权重）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=aishoes
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
